  m_Script: {fileID: 11500000, guid: a1c849fb49c58724db0bb88d08397e20, type: 3}
  m_Name: Greeting with Tansy
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: f4dcb036e6524d346904020c2a181f0f, type: 2}
    text: Hello,Night Runner.
  - speaker: {fileID: 11400000, guid: f4dcb036e6524d346904020c2a181f0f, type: 2}
    text: I heard you just released a new devlog for Willard, talking about animation!
  - speaker: {fileID: 11400000, guid: 941bbe227728ab54abe46c198d6d25aa, type: 2}
    text: Sure did! You should check it out, Tansy!
  options:
  - optionTxet: Tell me more
    nexDialogue: {fileID: 11400000, guid: e016dc3517307c24685ac2c17012791a, type: 2}
  - optionTxet: No Interested
    nexDialogue: {fileID: 0}
